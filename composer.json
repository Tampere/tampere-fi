    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "mnsami/composer-custom-directory-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true,
            "wikimedia/composer-merge-plugin": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/robots.txt": {
                    "mode": "skip"
                },
                "[web-root]/web.config": {
                    "mode": "skip"
                },
                "[web-root]/sites/default/default.settings.php": {
                    "append": "composer-scaffold-assets/database-settings.txt"
                },
                "[web-root]/sites/default/settings.php": {
                    "mode": "replace",
                    "path": "composer-scaffold-assets/settings.php"
                },
                "[web-root]/sites/development.services.yml": {
                    "mode": "replace",
                    "path": "composer-scaffold-assets/development.services.yml"
                }
            }
        },
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "swagger-api/swagger-ui",
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "patches": {
            "drupal/core": {
                "#2546212: Entity view/form mode formatter/widget settings have no translation UI": "https://www.drupal.org/files/issues/2026-04-24/2546212-336-named-list.patch",
                "2802371 - No active language in language switcher": "https://www.drupal.org/files/issues/2026-04-14/2802371-40.patch",
                "2230909 - Simple decimals fail to pass validation for Drupal v10.2": "https://www.drupal.org/files/issues/2026-03-30/2230909-simple-decimals-fail-validation-11.3.x-hacky-disable-validation-MR152288.patch",
                "2868014 - Views Date Filter Datetime Granularity Option": "https://www.drupal.org/files/issues/2025-07-22/2868014-141.patch",
                "2993688 - Views relationships with multi-valued entity reference fields invalidate Distinct query option - 99": "https://www.drupal.org/files/issues/2022-06-16/2993688-99.patch",
                "3171835 - Field Groups marked as required are missing red asterisk": "https://www.drupal.org/files/issues/2024-09-05/3171835-90--reroll-74-10.3.patch",
                "3445965 - Content translation: remove warning message about untranslatable fields being hidden": "https://git.drupalcode.org/issue/drupal-3445965/-/commit/78cec6047a861250ae4ef65f9eb69f5947bbc1f6.patch",
                "1166282 - Remove truncation from parent menu": "https://www.drupal.org/files/issues/2023-01-15/1166282-56.patch",
                "2511878 - Support enclosure field in Views RssFields row plugin - D11.4": "https://www.drupal.org/files/issues/2026-08-10/drupal-core-2511878-95_0.patch"
            },
            "drupal/dropzonejs": {
                "3341846 REVERT - Media library form breaking getFormId() function": "patches/dropzonejs-remove-media-library-form-breaking-getFormId-function-added-in-issue-3341846.patch"
            },
            "drupal/elb": {
                "CARE-8696 - When checking prohibited strings, only check the link domain": "patches/elb_check_domain.patch"
            },
            "drupal/external_data_source": {
                "3259684 - ExternalDataSource widgets break Dependency Injection - fix-5": "https://www.drupal.org/files/issues/2023-08-22/3259684_dependency_injection_fix-5.patch",
                "3371626 - Can't add new elements with autocomplete widget": "https://www.drupal.org/files/issues/2023-08-22/3371626_multiple_value_auto_complete_fix.patch"
            },
            "drupal/feeds": {
                "3080098 - Delete Empty Files Created If Empty/Error Exception is Returned": "https://www.drupal.org/files/issues/2024-12-12/delete-empty-error-file_3080098_7_for_3.0-rc3.patch"
            },
            "drupal/field_group": {
                "2969051 - HTML5 Validation Prevents Submission in Tabs": "https://www.drupal.org/files/issues/2024-08-09/2969051-148.patch"
            },
            "drupal/group": {
                "2815971 - More contexts": "https://www.drupal.org/files/issues/2024-12-16/group-context-2815971-2-52.patch",
                "Load group using group parameter - group 8.x-1.5": "patches/load_group_using_group_parameter.patch",
                "3322761 - Group module v2 base field override updates": "patches/group_module_v2_updates_3322761.patch",
                "3330913 - Service is missing even though module is enabled": "https://www.drupal.org/files/issues/2023-10-20/service-is-missing-even-though-module-is-enabled--3330913--21.patch"
            },
            "drupal/group_scheduled_transitions": {
                "Access return fix for group scheduled transitions": "patches/make_group_scheduled_transitions_allow_drupal-wide_transitions_for_non_group_members.patch",
                "3430850 Automated Drupal 11 compatibility fixes for group_scheduled_transitions": "https://www.drupal.org/files/issues/2024-03-17/group_scheduled_transitions.2.0.1.rector.patch"
            },
            "drupal/linkit": {
                "2886455: Add support for multilanguage": "https://www.drupal.org/files/issues/2026-06-26/2886455-102.patch"
            },
            "drupal/metatag": {
                "Change the value separator to ; so that multivalue tag is separated and not combined untintentionally": "./patches/metatag_multivalue_separator.patch"
